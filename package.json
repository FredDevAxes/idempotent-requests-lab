{
  "name": "idempotent-requests-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node apps/api/dist/migrate.js",
    "dev": "node scripts/dev.mjs",
    "test:unit": "node --test tests/unit.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.cjs",
    "test:browser": "playwright test",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:browser",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "globals": "16.5.0"
  }
}
