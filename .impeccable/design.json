  "narrative": {
    "northStar": "The Rehearsal Cue Sheet",
    "overview": "The rehearsal cue sheet gives each action a clear place and each observation a readable explanation. Cool paper, deep navy ink and restrained cobalt controls support an accompanied demonstration without decorative staging.\n\nThe system separates action, evidence and uncertainty through language, borders and paired state colors. Its depth is flat, its typography is deliberately legible, and its SVG symbols supplement words rather than carrying meaning alone.",
    "keyCharacteristics": [
      "Readable task typography with tabular numerals.",
      "Flat white observation surfaces on cool paper.",
      "State colors paired with explicit result text.",
      "Responsive comparison panels and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Green marks observed saved facts; violet marks unknown confirmation or a refused content change. Keep their text explanations alongside the color.",
        "section": "colors"
      },
      {
        "name": "The Readable Voice Rule",
        "body": "Use the sourced Atkinson family for task and explanatory text; reserve monospace for raw technical identifiers.",
        "section": "typography"
      },
      {
        "name": "The Flat Evidence Rule",
        "body": "Separate observations with borders and quiet surface changes rather than shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep a visible focus outline and named keyboard-operable controls.",
      "Do pair each state color and SVG symbol with readable result text.",
      "Do let long technical identifiers wrap and comparison panels stack on narrow screens.",
      "Do preserve self-hosted font assets and their OFL notice."
    ],
    "donts": [
      "Don't treat unavailable server evidence as a zero count or a successful result.",
      "Don't use color or an icon as the only indication of an outcome.",
      "Don't add decorative elevation to the flat observation surfaces."
    ]
  }
}
